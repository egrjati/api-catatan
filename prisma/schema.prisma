generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Pengeluaran {
  id        String   @id @default(uuid())
  nama      String
  harga     Int
  tanggal   DateTime @db.Date
  kategori  String
  createdAt DateTime @default(now())
}
